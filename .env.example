# WebUntis Server Settings
WEBUNTIS_SERVER=schuldorf.webuntis.com
WEBUNTIS_SCHOOL=schuldorf

# Default User
WEBUNTIS_USER=your_username
WEBUNTIS_PASSWORD=your_password

# Default number of days to fetch (optional)
WEBUNTIS_DEFAULT_DAYS=1

# Skip weekends (optional, skips Sat/Sun with --days)
SKIP_WEEKENDS=true

# Manual weekday skip list (optional, 0=Mon 6=Sun, overrides SKIP_WEEKENDS)
# IGNORE_DAYS=5,6

# Additional users (optional)
# WEBUNTIS_USER_BENNY=benny_username
# WEBUNTIS_PASSWORD_BENNY=benny_password
